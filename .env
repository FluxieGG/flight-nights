# Backend Server Port
PORT=3001

# OpenDartboard Vision Daemon WebSocket URL (Windows 10 Localhost)
OPENDARTBOARD_WS_URL=ws://localhost:13520

# Reconnection interval in milliseconds
OPENDARTBOARD_RECONNECT_MS=3000

# Camera device identifiers on Windows 10 (DirectShow / MediaFoundation Camera Indices)
CAMERA_1_DEVICE=USB Camera 0
CAMERA_2_DEVICE=USB Camera 1
CAMERA_3_DEVICE=USB Camera 2

# Optional MJPEG / HTTP stream URLs from OpenDartboard
CAMERA_1_STREAM_URL=
CAMERA_2_STREAM_URL=
CAMERA_3_STREAM_URL=
